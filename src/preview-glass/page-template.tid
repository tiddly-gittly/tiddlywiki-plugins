title: $:/plugins/linonetwo/preview-glass/page-template
tags: $:/tags/PageTemplate

\define preview-state-prefix() $:/state/preview-glass/popup/

\define handle-close()
<$action-deletetiddler $tiddler=<<stateTitle>> />
\end

<!-- The preview popup(s) - shown when state tiddlers exist -->
<$list filter="[all[tiddlers+shadows]prefix<preview-state-prefix>sort[title]]" variable="stateTitle">
  <$let previewTiddler={{{ [<stateTitle>get[text]] }}} previewDepth={{{ [<stateTitle>removeprefix<preview-state-prefix>] }}}>
    <$list filter="[<previewTiddler>!is[blank]]" variable="null">
      <$tiddler tiddler=<<previewTiddler>>>
        <div 
          class="tc-preview-popup tc-preview-glass"
          data-preview-depth=<<previewDepth>>
          style={{{ [<stateTitle>get[x]addprefix[left:]addsuffix[px;]] [<stateTitle>get[y]addprefix[top:]addsuffix[px;]] +[join[ ]] }}}
        >
          <div class="tc-preview-popup-inner">
            <div class="tc-preview-header">
              <span class="tc-preview-title">{{!!title}}</span>
              <$button class="tc-btn-invisible tc-preview-close" tooltip="Close preview">
                <<handle-close>>
                {{$:/core/images/close-button}}
              </$button>
            </div>

            <div class="tc-preview-content">
              <$transclude 
                tiddler={{{ [[$:/plugins/linonetwo/preview-glass/defaults/template]get[text]else[$:/plugins/linonetwo/preview-glass/template]] }}}
                mode="block"
              />
            </div>
          </div>
        </div>
      </$tiddler>
    </$list>
  </$let>
</$list>
